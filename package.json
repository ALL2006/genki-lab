{
  "name": "genki-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:prod": "tsx server/index.ts",
    "automation:daily": "tsx server/cli/automationDaily.ts",
    "automation:daily:dry": "tsx server/cli/automationDaily.ts --dry-run",
    "ai:prepare-development": "tsx server/cli/prepareDevelopment.ts",
    "ai:import-b2-pilot": "tsx server/cli/importB2Pilot.ts",
    "analysis-text:backfill": "tsx server/cli/backfillAnalysisText.ts",
    "ai:evaluate-holdout": "tsx server/cli/evaluateHoldout.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:api": "tsx tests/api.integration.ts",
    "test:collectors": "tsx tests/collectors.integration.ts",
    "test:ai": "tsx tests/ai.integration.ts",
    "test:analysis-batches": "tsx tests/analysis-batches.integration.ts",
    "test:analysis-text": "tsx tests/analysis-text.integration.ts",
    "test:ai:live": "tsx tests/ark-ai.smoke.ts",
    "test:live": "tsx tests/live-collection.smoke.ts",
    "test:automation": "tsx tests/automation.integration.ts",
    "test:bootstrap": "tsx tests/bootstrap.integration.ts",
    "cf:dev": "wrangler dev",
    "cf:dev:scheduled": "wrangler dev --test-scheduled",
    "cf:test": "npm run build && npm run cf:bundle && tsx scripts/cf-runtime-test.ts",
    "cf:bundle": "tsx scripts/cloudflare-bundle.ts",
    "cf:deploy": "wrangler deploy",
    "cf:tail": "wrangler tail genki-lab",
    "d1:migrations:local": "wrangler d1 migrations apply genki-lab-production --local",
    "d1:migrations:remote": "wrangler d1 migrations apply genki-lab-production --remote",
    "d1:prepare-import": "tsx scripts/export-json-to-d1.ts",
    "d1:import:remote": "wrangler d1 execute genki-lab-production --remote --file data/migrations/generated/genki-lab-production-seed.sql",
    "d1:verify": "tsx scripts/verify-d1.ts",
    "d1:verify:remote": "tsx scripts/verify-d1.ts --remote",
    "cloudflare:setup": "tsx scripts/cloudflare-setup.ts",
    "cloudflare:secrets": "tsx scripts/configure-cloudflare-secrets.ts",
    "cloudflare:verify": "tsx scripts/cloudflare-verify.ts",
    "check": "npm run lint && npm run typecheck && npm run test:collectors && npm run test:api && npm run test:ai && npm run test:analysis-batches && npm run test:analysis-text && npm run test:automation && npm run test:bootstrap && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cheerio": "^1.2.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.2",
    "recharts": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@eslint/js": "^9.32.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "latest",
    "typescript-eslint": "^8.38.0",
    "vite": "latest",
    "wrangler": "^4.120.0"
  }
}
