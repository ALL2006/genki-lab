{
  "name": "genki-lab-video-remotion",
  "version": "1.0.0",
  "description": "Configuration-driven vertical beverage product ad templates",
  "scripts": {
    "predev": "npm run check:assets && npm run typecheck",
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "upgrade": "remotion upgrade",
    "lint": "eslint src scripts && tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit",
    "prestill:assets": "npm run check:assets && npm run typecheck",
    "still:assets": "remotion still src/index.ts AssetCheck out/asset-check.png --frame=0",
    "prestills:ad": "npm run check:assets && npm run typecheck",
    "stills:ad": "node scripts/render-stills.mjs",
    "prerender:ad": "npm run check:assets && npm run typecheck",
    "render:ad": "remotion render src/index.ts QingtiJasmineAd out/qingti-jasmine-ad.mp4 --codec=h264"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.491",
    "@remotion/motion-blur": "4.0.491",
    "@remotion/noise": "4.0.491",
    "@remotion/shapes": "4.0.491",
    "@remotion/transitions": "4.0.491",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.491"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.491",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3"
  },
  "private": true
}
